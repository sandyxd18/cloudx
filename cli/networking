#!/usr/bin/env python3
import json
import os

import requests
import typer


API = os.getenv("NETWORKING_API_URL", "http://localhost:8001").rstrip("/")
COMPUTE_API = os.getenv("COMPUTE_API_URL", "http://localhost:8003").rstrip("/")
CONTEXT_SETTINGS = {"help_option_names": ["-h", "--help"]}
app = typer.Typer(help="CLI for CloudX networking-api. Example: networking network create private-net", context_settings=CONTEXT_SETTINGS)
network_app = typer.Typer(help="Manage virtual networks.", context_settings=CONTEXT_SETTINGS)
subnet_app = typer.Typer(help="Manage subnets and gateway metadata.", context_settings=CONTEXT_SETTINGS)
router_app = typer.Typer(help="Manage OVN logical routers.", context_settings=CONTEXT_SETTINGS)
port_app = typer.Typer(help="Manage logical switch ports.", context_settings=CONTEXT_SETTINGS)
fip_app = typer.Typer(name="floating-ip", help="Manage floating IP metadata.", context_settings=CONTEXT_SETTINGS)
sg_app = typer.Typer(name="security-group", help="Manage OVN ACL backed security groups.", context_settings=CONTEXT_SETTINGS)
sg_rule_app = typer.Typer(name="rule", help="Manage security group rules.", context_settings=CONTEXT_SETTINGS)
ovn_app = typer.Typer(help="Inspect OVN state.", context_settings=CONTEXT_SETTINGS)


def emit(data):
    typer.echo(json.dumps(data, indent=2, default=str))


def request(method, path, **kwargs):
    response = requests.request(method, f"{API}{path}", timeout=20, **kwargs)
    if response.status_code >= 400:
        try:
            detail = response.json()
        except ValueError:
            detail = response.text
        raise typer.BadParameter(f"API error {response.status_code}: {detail}")
    return response.json()


def compute_request(method, path, **kwargs):
    response = requests.request(method, f"{COMPUTE_API}{path}", timeout=20, **kwargs)
    if response.status_code >= 400:
        try:
            detail = response.json()
        except ValueError:
            detail = response.text
        raise typer.BadParameter(f"compute API error {response.status_code}: {detail}")
    return response.json()


@network_app.command("create")
def network_create(
    name: str,
    external: bool = typer.Option(False, "--external", help="Create an external/provider network."),
):
    emit(
        request(
            "POST",
            "/networks",
            json={"name": name, "external": external},
        )
    )


@network_app.command("list")
def network_list():
    emit(request("GET", "/networks"))


@network_app.command("show")
def network_show(ref: str):
    emit(request("GET", f"/networks/{ref}"))


@network_app.command("delete")
def network_delete(ref: str):
    emit(request("DELETE", f"/networks/{ref}"))


@subnet_app.command("create")
def subnet_create(
    name: str,
    network: str = typer.Option(...),
    cidr: str = typer.Option(...),
    gateway: str = typer.Option(...),
    allocation_start: str | None = typer.Option(None, "--allocation-start"),
    allocation_end: str | None = typer.Option(None, "--allocation-end"),
    dns_nameserver: list[str] = typer.Option([], "--dns-nameserver"),
    dhcp: bool = typer.Option(True, "--dhcp/--no-dhcp"),
):
    emit(
        request(
            "POST",
            "/subnets",
            json={
                "name": name,
                "network": network,
                "cidr": cidr,
                "gateway": gateway,
                "allocation_start": allocation_start,
                "allocation_end": allocation_end,
                "dns_nameservers": dns_nameserver,
                "enable_dhcp": dhcp,
            },
        )
    )


@subnet_app.command("list")
def subnet_list():
    emit(request("GET", "/subnets"))


@subnet_app.command("show")
def subnet_show(ref: str):
    emit(request("GET", f"/subnets/{ref}"))


@subnet_app.command("delete")
def subnet_delete(ref: str):
    emit(request("DELETE", f"/subnets/{ref}"))


@router_app.command("create")
def router_create(name: str):
    emit(request("POST", "/routers", json={"name": name}))


@router_app.command("list")
def router_list():
    emit(request("GET", "/routers"))


@router_app.command("show")
def router_show(ref: str):
    emit(request("GET", f"/routers/{ref}"))


@router_app.command("delete")
def router_delete(ref: str):
    emit(request("DELETE", f"/routers/{ref}"))


@router_app.command("add-interface")
def router_add_interface(ref: str, subnet: str = typer.Option(...)):
    emit(request("POST", f"/routers/{ref}/interfaces", json={"subnet": subnet}))


@router_app.command("remove-interface")
def router_remove_interface(ref: str, subnet: str = typer.Option(...)):
    emit(request("DELETE", f"/routers/{ref}/interfaces/{subnet}"))


@router_app.command("set-gateway")
def router_set_gateway(ref: str, external_network: str):
    emit(request("POST", f"/routers/{ref}/gateway", json={"external_network": external_network}))


@port_app.command("create")
def port_create(
    name: str,
    network: str = typer.Option(...),
    ip_address: str | None = typer.Option(None, "--ip-address"),
    device_id: str | None = typer.Option(None, "--device-id"),
    device_owner: str | None = typer.Option(None, "--device-owner"),
    security_group: list[str] = typer.Option([], "--security-group"),
):
    emit(
        request(
            "POST",
            "/ports",
            json={
                "name": name,
                "network": network,
                "ip_address": ip_address,
                "device_id": device_id,
                "device_owner": device_owner,
                "security_group_ids": security_group,
            },
        )
    )


@port_app.command("list")
def port_list():
    emit(request("GET", "/ports"))


@port_app.command("show")
def port_show(ref: str):
    emit(request("GET", f"/ports/{ref}"))


@port_app.command("delete")
def port_delete(ref: str):
    emit(request("DELETE", f"/ports/{ref}"))


@port_app.command("set-security-group")
def port_set_security_group(ref: str, security_group: list[str] = typer.Option(..., "--security-group")):
    emit(request("POST", f"/ports/{ref}/security-groups", json={"security_group_ids": security_group}))


@port_app.command("clear-security-groups")
def port_clear_security_groups(ref: str):
    emit(request("POST", f"/ports/{ref}/security-groups/clear"))


@port_app.command("security-enable")
def port_security_enable(ref: str):
    emit(request("POST", f"/ports/{ref}/security/enable"))


@port_app.command("security-disable")
def port_security_disable(ref: str):
    emit(request("POST", f"/ports/{ref}/security/disable"))


@port_app.command("ovn-show")
def port_ovn_show(ref: str):
    emit(request("GET", f"/ports/{ref}/ovn"))


@fip_app.command("create")
def fip_create(
    external_network: str,
    name: str | None = typer.Option(None, "--name"),
    floating_ip: str | None = typer.Option(None, "--floating-ip"),
    fixed_port: str | None = typer.Option(None, "--fixed-port"),
):
    emit(request("POST", "/floating-ips", json={"name": name, "external_network": external_network, "floating_ip": floating_ip, "fixed_port": fixed_port}))


@fip_app.command("list")
def fip_list():
    emit(request("GET", "/floating-ips"))


@fip_app.command("show")
def fip_show(ref: str):
    emit(request("GET", f"/floating-ips/{ref}"))


@fip_app.command("delete")
def fip_delete(ref: str):
    emit(request("DELETE", f"/floating-ips/{ref}"))


@fip_app.command("associate")
def fip_associate(
    ref: str,
    server: str | None = typer.Option(None, "--server"),
    port: str | None = typer.Option(None, "--port"),
    router: str | None = typer.Option(None, "--router"),
):
    if server and not port:
        port = compute_request("GET", f"/servers/{server}")["port_id"]
    emit(request("POST", f"/floating-ips/{ref}/associate", json={"port": port, "server": server, "router": router}))


@fip_app.command("disassociate")
def fip_disassociate(ref: str):
    emit(request("POST", f"/floating-ips/{ref}/disassociate"))


@sg_app.command("create")
def sg_create(name: str, description: str | None = typer.Option(None, "--description")):
    emit(request("POST", "/security-groups", json={"name": name, "description": description}))


@sg_app.command("list")
def sg_list():
    emit(request("GET", "/security-groups"))


@sg_app.command("show")
def sg_show(ref: str):
    emit(request("GET", f"/security-groups/{ref}"))


@sg_app.command("delete")
def sg_delete(ref: str):
    emit(request("DELETE", f"/security-groups/{ref}"))


@sg_app.command("ovn-show")
def sg_ovn_show(ref: str):
    emit(request("GET", f"/security-groups/{ref}/ovn"))


@sg_rule_app.command("create")
def sg_rule_create(
    security_group: str,
    direction: str = typer.Option(..., "--direction"),
    protocol: str = typer.Option("any", "--protocol"),
    port: int | None = typer.Option(None, "--port"),
    remote_ip: str | None = typer.Option(None, "--remote-ip"),
    remote_group: str | None = typer.Option(None, "--remote-group"),
):
    emit(
        request(
            "POST",
            f"/security-groups/{security_group}/rules",
            json={
                "direction": direction,
                "protocol": protocol,
                "port_min": port,
                "port_max": port,
                "remote_ip_prefix": remote_ip,
                "remote_group_id": remote_group,
            },
        )
    )


@sg_rule_app.command("list")
def sg_rule_list(security_group: str):
    emit(request("GET", f"/security-groups/{security_group}/rules"))


@sg_rule_app.command("delete")
def sg_rule_delete(rule_id: str):
    emit(request("DELETE", f"/security-group-rules/{rule_id}"))


@ovn_app.command("show")
def ovn_show():
    emit(request("GET", "/ovn/show"))


app.add_typer(network_app, name="network")
app.add_typer(subnet_app, name="subnet")
app.add_typer(router_app, name="router")
app.add_typer(port_app, name="port")
app.add_typer(fip_app, name="floating-ip")
sg_app.add_typer(sg_rule_app, name="rule")
app.add_typer(sg_app, name="security-group")
app.add_typer(ovn_app, name="ovn")


if __name__ == "__main__":
    app()
