#!/usr/bin/env python3
import json
import os
from pathlib import Path

import requests
import typer


API = os.getenv("IMAGE_API_URL", "http://localhost:8002").rstrip("/")
CONTEXT_SETTINGS = {"help_option_names": ["-h", "--help"]}
app = typer.Typer(help="CLI for mini OpenStack lab image-api. Example: image upload ubuntu --file ./ubuntu.qcow2 --disk-format qcow2", context_settings=CONTEXT_SETTINGS)


def emit(data):
    typer.echo(json.dumps(data, indent=2, default=str))


def request(method, path, **kwargs):
    response = requests.request(method, f"{API}{path}", timeout=60, **kwargs)
    if response.status_code >= 400:
        try:
            detail = response.json()
        except ValueError:
            detail = response.text
        raise typer.BadParameter(f"API error {response.status_code}: {detail}")
    return response.json()


@app.command("upload")
def upload(name: str, file: Path = typer.Option(..., "--file", exists=True), disk_format: str = typer.Option("qcow2", "--disk-format"), container_format: str = typer.Option("bare", "--container-format")):
    with file.open("rb") as handle:
        emit(request("POST", "/images", data={"name": name, "disk_format": disk_format, "container_format": container_format}, files={"file": (file.name, handle)}))


@app.command("list")
def list_images():
    emit(request("GET", "/images"))


@app.command("show")
def show(ref: str):
    emit(request("GET", f"/images/{ref}"))


@app.command("delete")
def delete(ref: str):
    emit(request("DELETE", f"/images/{ref}"))


if __name__ == "__main__":
    app()
