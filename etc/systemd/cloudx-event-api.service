[Unit]
Description=CloudX Event API Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
EnvironmentFile=/etc/cloudx/cloudx.env
Type=simple
User=cloudx
Group=cloudx
WorkingDirectory=/opt/cloudx/services/event
ExecStart=/opt/cloudx/venv/bin/gunicorn -w 2 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8012 app.main:app
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
