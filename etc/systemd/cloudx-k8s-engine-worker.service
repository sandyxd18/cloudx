[Unit]
Description=CloudX K8s Engine Worker (provisioner for managed Kubernetes clusters)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cloudx/services/k8s_engine_worker
ExecStart=/opt/cloudx/venv/bin/python -m app.main
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
