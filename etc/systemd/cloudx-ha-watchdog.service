[Unit]
Description=CloudX HA Watchdog (self-fencing, compute nodes)
After=network.target libvirtd.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cloudx/services/ha_watchdog
ExecStart=/opt/cloudx/venv/bin/python -m app.main
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
