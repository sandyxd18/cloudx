[Unit]
Description=CloudX Billing Worker
After=network.target cloudx-billing-api.service

[Service]
Type=simple
User=cloudx
Group=cloudx
WorkingDirectory=/opt/cloudx/services/billing_worker
ExecStart=/opt/cloudx/venv/bin/python -m app.main
StateDirectory=cloudx-billing
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
