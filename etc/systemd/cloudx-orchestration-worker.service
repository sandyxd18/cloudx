[Unit]
Description=CloudX Orchestration Worker (auto-scaling)
After=network.target cloudx-orchestration-api.service

[Service]
EnvironmentFile=-/etc/cloudx/cloudx.env
Environment=AUTH_API_URL=http://127.0.0.1:8005
Environment=ORCHESTRATION_API_URL=http://127.0.0.1:8013
Environment=COMPUTE_API_URL=http://127.0.0.1:8003
Environment=TELEMETRY_API_URL=http://127.0.0.1:8010
Environment=LOAD_BALANCER_API_URL=http://127.0.0.1:8008
Type=simple
User=cloudx
Group=cloudx
WorkingDirectory=/opt/cloudx/services/orchestration_worker
ExecStart=/opt/cloudx/venv/bin/python -m app.main
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
