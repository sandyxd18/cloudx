[Unit]
Description=CloudX Metadata API Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Environment=PYTHONPATH=/opt/cloudx/services
Environment=AUTH_API_URL=http://192.168.10.10:8005
Environment=NETWORKING_API_URL=http://192.168.10.10:8001
Environment=COMPUTE_API_URL=http://192.168.10.10:8003
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cloudx/services/metadata
ExecStart=/opt/cloudx/venv/bin/gunicorn -w 2 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8775 app.main:app
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
