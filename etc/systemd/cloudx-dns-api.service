[Unit]
Description=CloudX DNS API Service (Designate-like)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=cloudx
Group=cloudx
WorkingDirectory=/opt/cloudx/services/dns
ExecStart=/opt/cloudx/venv/bin/gunicorn -w 2 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8016 app.main:app
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target