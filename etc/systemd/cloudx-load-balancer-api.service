[Unit]
Description=CloudX Load Balancer API Service (Octavia-like)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Environment=PYTHONPATH=/opt/cloudx/services
Environment=AUTH_API_URL=http://192.168.10.10:8005
Environment=COMPUTE_API_URL=http://192.168.10.10:8003
Environment=NETWORKING_API_URL=http://192.168.10.10:8001
Environment=RABBITMQ_URL=amqp://mini:mini@192.168.10.10:5672/
Type=simple
User=cloudx
Group=cloudx
WorkingDirectory=/opt/cloudx/services/load_balancer
ExecStart=/opt/cloudx/venv/bin/gunicorn -w 2 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8008 app.main:app
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
