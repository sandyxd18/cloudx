[Unit]
Description=CloudX Conductor Service (Compute Conductor DB Proxy)
After=network.target postgresql.service rabbitmq-server.service
Wants=postgresql.service rabbitmq-server.service

[Service]
EnvironmentFile=-/etc/cloudx/cloudx.env
Environment=DATABASE_URL=postgresql+psycopg://cloudx:cloudx@127.0.0.1:5432/cloudx
Environment=RABBITMQ_URL=amqp://cloudx:cloudx@127.0.0.1:5672/
Type=simple
User=cloudx
Group=cloudx
WorkingDirectory=/opt/cloudx/services/conductor
ExecStart=/opt/cloudx/venv/bin/python3 -m app.main
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
