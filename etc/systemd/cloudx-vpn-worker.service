[Unit]
Description=CloudX VPN Worker (strongSwan charon/swanctl for VPN gateways) (compute/storage node)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cloudx/services/vpn_worker
ExecStart=/opt/cloudx/venv/bin/python -m app.main
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
