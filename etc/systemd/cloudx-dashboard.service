[Unit]
Description=CloudX Horizon Dashboard Service (React + FastAPI Proxy)
After=network.target cloudx-auth-api.service cloudx-compute-api.service cloudx-networking-api.service
Wants=cloudx-auth-api.service cloudx-compute-api.service cloudx-networking-api.service

[Service]
Environment=PYTHONPATH=/opt/cloudx/services
Environment=HOST=0.0.0.0
Environment=PORT=8080
Environment=MEMCACHED_URL=127.0.0.1:11211
Environment=RABBITMQ_URL=amqp://mini:mini@192.168.10.10:5672/
Environment=AUTH_API_URL=http://192.168.10.10:8005
Environment=COMPUTE_API_URL=http://192.168.10.10:8003
Environment=NETWORKING_API_URL=http://192.168.10.10:8001
Environment=IMAGE_API_URL=http://192.168.10.10:8002
Environment=BLOCK_STORE_API_URL=http://192.168.10.10:8004
Environment=PLACEMENT_API_URL=http://192.168.10.10:8006
Environment=OBJECT_STORE_API_URL=http://192.168.10.10:8007
Environment=LOAD_BALANCER_API_URL=http://192.168.10.10:8008
Environment=TELEMETRY_API_URL=http://192.168.10.10:8010
Environment=BILLING_API_URL=http://192.168.10.10:8011
Environment=EVENT_API_URL=http://192.168.10.10:8012
Environment=ORCHESTRATION_API_URL=http://192.168.10.10:8013
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cloudx/services/dashboard
ExecStart=/opt/cloudx/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
