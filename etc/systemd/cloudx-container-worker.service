[Unit]
Description=CloudX Container Worker (Docker, compute nodes)
After=network.target openvswitch-switch.service ovn-controller.service docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cloudx/services/container_worker
ExecStart=/opt/cloudx/venv/bin/python -m app.main
KillMode=process
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
