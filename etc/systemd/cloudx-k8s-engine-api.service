[Unit]
Description=CloudX Kubernetes Engine API Service (Magnum-like)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Environment=PYTHONPATH=/opt/cloudx/services
Type=simple
User=cloudx
Group=cloudx
WorkingDirectory=/opt/cloudx/services/k8s_engine
ExecStart=/opt/cloudx/venv/bin/gunicorn -w 2 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8015 app.main:app
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
