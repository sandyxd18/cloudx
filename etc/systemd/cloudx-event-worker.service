[Unit]
Description=CloudX Event Webhook Worker
After=network.target cloudx-event-api.service

[Service]
Type=simple
User=cloudx
Group=cloudx
WorkingDirectory=/opt/cloudx/services/event_worker
ExecStart=/opt/cloudx/venv/bin/python -m app.main
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
