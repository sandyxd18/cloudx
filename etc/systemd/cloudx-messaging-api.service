[Unit]
Description=CloudX Messaging API Service (Zaqar-like)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=cloudx
Group=cloudx
WorkingDirectory=/opt/cloudx/services/messaging
ExecStart=/opt/cloudx/venv/bin/gunicorn -w 2 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8022 app.main:app
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
