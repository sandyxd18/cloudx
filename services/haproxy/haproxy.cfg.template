global
    log /dev/log    local0
    log /dev/log    local1 notice
    maxconn         4096
    daemon

defaults
    log             global
    mode            http
    option          httplog
    option          dontlognull
    option          forwardfor
    option          http-server-close
    timeout connect 5s
    timeout client  30s
    timeout server  60s
    retries         3
    errorfile 400   /dev/null
    errorfile 408   /dev/null
    errorfile 502   /dev/null
    errorfile 503   /dev/null
    errorfile 504   /dev/null

# ── Stats & Monitoring ────────────────────────────────────────────────────────
frontend stats
    bind *:${HAPROXY_STATS_PORT:-8404}
    stats enable
    stats uri /stats
    stats refresh 10s
    stats admin if TRUE
    stats show-legends
    stats show-node

# ── Dashboard ────────────────────────────────────────────────────────────────
frontend dashboard_front
    bind *:${DASHBOARD_PORT:-8080}
    option httpchk
    default_backend dashboard_back

backend dashboard_back
    option httpchk GET /health
    http-check expect status 200
    server node1 127.0.0.1:${DASHBOARD_PORT:-8080} check inter 5s fall 3 rise 2

