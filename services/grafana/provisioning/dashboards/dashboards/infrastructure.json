{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "CloudX — Infrastructure",
  "tags": ["cloudx", "infra"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "RabbitMQ Queue Depth",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rabbitmq_queue_messages) by (queue)", "legendFormat": "{{queue}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL Active Connections",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "pg_stat_activity_count", "legendFormat": "{{datname}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL Replication Lag (bytes)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "targets": [
        { "expr": "pg_replication_lag_bytes", "legendFormat": "lag", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "HAProxy Backend Sessions",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "targets": [
        { "expr": "haproxy_backend_current_sessions", "legendFormat": "{{proxy}}", "refId": "A" }
      ]
    }
  ]
}
