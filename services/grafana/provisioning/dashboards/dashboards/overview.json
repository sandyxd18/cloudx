{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "CloudX — Overview",
  "tags": ["cloudx"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "API Targets Up",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(up{job=\"cloudx-apis\"})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "stat",
      "title": "Total Request Rate (req/s)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(rate(cloudx_api_requests_total[5m]))", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "5xx Error Rate",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(cloudx_api_requests_total{status=~\"5..\"}[5m]))", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Node Up",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(up{job=\"node\"})", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Rate by Service",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum(rate(cloudx_api_requests_total[5m])) by (service)", "legendFormat": "{{service}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Latency by Service",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(cloudx_api_request_latency_seconds_bucket[5m])) by (le, service))", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Host CPU Usage",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "targets": [
        { "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "type": "timeseries",
      "title": "Host Memory Available",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "targets": [
        { "expr": "node_memory_MemAvailable_bytes", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}
