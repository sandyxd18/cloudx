# Keepalived VRRP configuration template for cloudx HA
# Variables substituted at runtime by start.sh:
#   NETWORK_INTERFACE       — management NIC (e.g. enp0s3)
#   INTERNAL_VIP_ADDRESS    — Virtual IP with prefix (e.g. 192.168.10.100/24)
#   KEEPALIVED_ROUTER_ID    — VRRP virtual router ID (1-255, unique per cluster)
#   KEEPALIVED_PRIORITY     — Node priority (100 = MASTER, 50 = BACKUP)
#   KEEPALIVED_AUTH_PASS    — VRRP auth passphrase (max 8 chars)
#   KEEPALIVED_PEER_IP      — Unicast peer IP (leave empty for multicast)

global_defs {
    router_id cloudx_${KEEPALIVED_ROUTER_ID:-51}
    script_user root
    enable_script_security
}

# Health check: verify HAProxy is responding
vrrp_script check_haproxy {
    script       "/usr/local/bin/check_haproxy.sh"
    interval     2      # Check every 2 seconds
    weight       -20    # Decrease priority by 20 if script fails
    fall         2      # Require 2 failures to trigger failover
    rise         2      # Require 2 successes to recover
}

vrrp_instance VI_1 {
    state            ${KEEPALIVED_STATE:-MASTER}
    interface        ${NETWORK_INTERFACE:-enp0s3}
    virtual_router_id ${KEEPALIVED_ROUTER_ID:-51}
    priority         ${KEEPALIVED_PRIORITY:-100}
    advert_int       1
    preempt_delay    30

    authentication {
        auth_type PASS
        auth_pass ${KEEPALIVED_AUTH_PASS:-cloudx01}
    }

    # VIP assigned to the management interface when MASTER
    virtual_ipaddress {
        ${INTERNAL_VIP_ADDRESS}
    }

    track_script {
        check_haproxy
    }

    notify_master  "/bin/bash -c 'echo MASTER  > /tmp/keepalived_state'"
    notify_backup  "/bin/bash -c 'echo BACKUP  > /tmp/keepalived_state'"
    notify_fault   "/bin/bash -c 'echo FAULT   > /tmp/keepalived_state'"
}
