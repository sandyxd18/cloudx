[Unit]
Description=CloudX Object Store API Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=cloudx
Group=cloudx
UMask=0007
WorkingDirectory=/opt/cloudx/services/object_store
ExecStart=/usr/bin/cloudx-object-store-api
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
