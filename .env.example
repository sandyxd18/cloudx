# ── Global ──────────────────────────────────────────────────────────────────
# Timezone applied to every container (logs, cron, backups). Asia/Jakarta default.
TIMEZONE=Asia/Jakarta

POSTGRES_DB=cloudx
POSTGRES_USER=mini
POSTGRES_PASSWORD=mini
DATABASE_URL=postgresql+psycopg://mini:mini@127.0.0.1:5432/cloudx

# ── Multi-Node Roles (Fase 5) ─────────────────────────────────────────────────
# CloudX can run as a single-node all-in-one (default docker-compose.yml) OR be
# split across dedicated nodes using the role-specific compose files:
#   docker-compose.control-plane.yml   → DB, RabbitMQ, OVN NB/SB+northd, APIs, dashboard
#   docker-compose.compute-node.yml    → compute-worker + local ovn-controller
#   docker-compose.storage-node.yml    → block-store-worker + MinIO
#
# CONTROLLER_IP: management IP of the Control Plane node. Compute & Storage nodes
#                point their RabbitMQ / API / OVN SB DB connections at this IP.
CONTROLLER_IP=10.0.0.11

# ── HA: HAProxy multi-backend (Fase 5) ────────────────────────────────────────
# Comma-separated backend IPs for round-robin across multiple API instances.
# Single controller: leave as 127.0.0.1. Multi-node: list all controller IPs.
AUTH_BACKENDS=127.0.0.1
NETWORKING_BACKENDS=127.0.0.1
IMAGE_BACKENDS=127.0.0.1
COMPUTE_BACKENDS=127.0.0.1
BLOCK_STORE_BACKENDS=127.0.0.1
PLACEMENT_BACKENDS=127.0.0.1
DASHBOARD_BACKENDS=127.0.0.1

# ── HA: RabbitMQ cluster (Fase 5) ─────────────────────────────────────────────
# Shared secret used by every node to form the Erlang cluster. MUST be identical
# across all RabbitMQ nodes. Only used by docker-compose.ha.yml.
RABBITMQ_ERLANG_COOKIE=cloudx-cluster-cookie-change-me
# Hostname of the primary/seed node the others join. Set per node in /etc/hosts
# or DNS so RABBITMQ_NODENAME resolves across the management network.
RABBITMQ_SEED_NODE=rabbit@rabbitmq-1

# ── HA: PostgreSQL streaming replication (Fase 5) ─────────────────────────────
# Replication role for this host: "primary" or "standby". Used by
# docker-compose.ha.yml to select the correct entrypoint.
POSTGRES_ROLE=primary
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator-change-me
# On a standby, point this at the primary's management IP.
POSTGRES_PRIMARY_HOST=10.0.0.11
POSTGRES_PRIMARY_PORT=5432
# Optional read-only URL routed to the hot standby.
DATABASE_READ_URL=postgresql+psycopg://mini:mini@10.0.0.12:5432/cloudx

# ── RabbitMQ (AMQP Message Broker) ───────────────────────────────────────
# RabbitMQ digunakan untuk komunikasi antar service (RPC Cast/Call).
# Compute API → Compute Worker via AMQP (async)
# Compute Worker → Conductor via AMQP (DB updates)
# Conductor → Dashboard via fanout exchange (live events)
RABBITMQ_URL=amqp://cloudx:cloudx@127.0.0.1:5672/
RABBITMQ_USER=cloudx
RABBITMQ_PASS=cloudx
# RPC Call timeout (seconds) — for synchronous operations like console log, VNC info
RPC_CALL_TIMEOUT=30

NETWORKING_API_URL=http://localhost:8001
IMAGE_API_URL=http://localhost:8002
COMPUTE_API_URL=http://localhost:8003
BLOCK_STORE_API_URL=http://localhost:8004
PLACEMENT_API_URL=http://localhost:8006
OBJECT_STORE_API_URL=http://localhost:8007
LOAD_BALANCER_API_URL=http://localhost:8008
METADATA_API_URL=http://localhost:8775
METADATA_PROXY_PORT=8776
NOVNC_BASE_URL=http://localhost:6080/vnc.html
DEFAULT_SECURITY_GROUP_ALLOW_SSH=true
DEFAULT_SECURITY_GROUP_ALLOW_ICMP=true

OVN_NB_DB=tcp:127.0.0.1:6641
OVN_SB_DB=tcp:127.0.0.1:6642

# ── Auth API (Keystone-like) ──────────────────────────────────────────────────
# CRITICAL: Change AUTH_SECRET_KEY in production!
AUTH_SECRET_KEY=cloudx-secret-key-change-in-production-min32chars!
AUTH_TOKEN_EXPIRE_HOURS=24
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123
AUTH_ADMIN_EMAIL=admin@cloudx.local
AUTH_ADMIN_PROJECT=admin

# ── Network Interfaces ────────────────────────────────────────────────────────
# NETWORK_INTERFACE   : Interface internal (management) antarnodeunuk.
#                       Digunakan sebagai Geneve tunnel endpoint untuk OVN multi-node.
#                       Contoh: enp0s3 (VirtualBox NAT/internal adapter).
# PROVIDER_INTERFACE  : Interface eksternal (host-only/provider adapter) yang diikat ke br-ex.
#                       Traffic VM keluar melalui interface ini.
# INTERNAL_VIP_ADDRESS: Virtual IP yang akan dikelola oleh Keepalived (Fase 2).
#                       Pada single-node: cukup isi IP statis node ini di jaringan provider.
#                       Format: IP/PREFIX (contoh: 192.168.10.102/24)
NETWORK_INTERFACE=enp0s3
PROVIDER_INTERFACE=enp0s8
INTERNAL_VIP_ADDRESS=192.168.10.102/24

# ── Keepalived / HA Configuration ─────────────────────────────────────────────
# KEEPALIVED_STATE      : MASTER (node utama, priority tinggi) atau BACKUP.
#                         Pada single-node selalu gunakan MASTER.
# KEEPALIVED_PRIORITY   : Semakin tinggi → lebih diprioritaskan menjadi MASTER.
#                         Master: 100, Backup: 50 (atau lebih rendah).
# KEEPALIVED_ROUTER_ID  : ID unik VRRP per kluster (1-255). Semua node dalam
#                         kluster yang sama harus menggunakan ID yang sama.
# KEEPALIVED_AUTH_PASS  : Passphrase autentikasi VRRP (max 8 karakter).
#                         Harus sama di semua node dalam satu kluster.
# HAPROXY_STATS_PORT    : Port dashboard statistik HAProxy (default: 8404).
#                         Akses via: http://<node-ip>:8404/stats
KEEPALIVED_STATE=MASTER
KEEPALIVED_PRIORITY=100
KEEPALIVED_ROUTER_ID=51
KEEPALIVED_AUTH_PASS=cloudx01
HAPROXY_STATS_PORT=8404

# ── Image storage ─────────────────────────────────────────────────────────────
IMAGE_STORAGE_BACKEND=minio
IMAGE_STORE_PATH=/var/lib/mini-openstack/images
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mini-openstack-images
MINIO_SECURE=false

# ── Compute ───────────────────────────────────────────────────────────────────
COMPUTE_BACKEND=libvirt
LIBVIRT_URI=qemu:///system
COMPUTE_INSTANCE_DIR=/var/lib/mini-openstack/compute/instances
COMPUTE_CACHE_DIR=/var/lib/mini-openstack/compute/cache
COMPUTE_IMAGE_CACHE_DIR=/var/lib/mini-openstack/compute/cache/images
OVS_BRIDGE=br-int
VM_NAME_PREFIX=mini-os

# ── Block Storage ─────────────────────────────────────────────────────────────
# Pilih minimal satu driver: STORAGE_LVM_DRIVER=true dan/atau STORAGE_CEPH_RBD_DRIVER=true
# Jika keduanya false, service block-store-api akan GAGAL START.
# Backend file/qcow2 sudah DIHAPUS — hanya LVM dan Ceph RBD yang didukung.
#
# PENTING: LVM dan Ceph adalah BACKEND INFRASTRUKTUR, bukan nama Volume Type.
# Volume Types (gp2, gp3, io1, io2, sc1, dst.) adalah performance profile yang
# harus dibuat oleh admin setelah services naik — TIDAK ADA auto-bootstrap.
# Setelah services aktif, jalankan:
#   cloudx volume-type create gp2 --backend lvm --disk-type sata_ssd --max-iops 3000 --max-throughput 125
#   cloudx volume-type create gp3 --backend lvm --disk-type sas_ssd  --max-iops 16000 --max-throughput 1000
#   cloudx volume-type create io2 --backend ceph --disk-type nvme_ssd --max-iops 64000 --max-throughput 4000
# Lihat README — Langkah 5 untuk contoh lengkap.

# ── LVM Driver ────────────────────────────────────────────────────────────────
# Aktifkan driver LVM (block device).
STORAGE_LVM_DRIVER=true
# LVM_PV_NAME: block device(s) untuk dijadikan Physical Volume.
# Bisa comma-separated jika lebih dari satu: /dev/sdb,/dev/sdc
# VG akan dibuat OTOMATIS saat startup jika belum ada.
# WAJIB diset jika STORAGE_LVM_DRIVER=true.
LVM_PV_NAME=/dev/sdb
# LVM_VG_NAME: nama Volume Group yang akan dibuat / digunakan.
LVM_VG_NAME=vg-cloudx

# ── Ceph RBD Driver ───────────────────────────────────────────────────────────
# Aktifkan driver Ceph RBD (network disk). Bisa aktif bersamaan dengan LVM.
STORAGE_CEPH_RBD_DRIVER=false
# CEPH_POOL: nama pool Ceph (wajib jika Ceph aktif).
CEPH_POOL=
CEPH_CONF=/etc/ceph/ceph.conf
CEPH_KEYRING=

# ── cloudx CLI defaults ──────────────────────────────────────────────────────
# These can also be set via ~/.cloudx/config
CLOUDX_AUTH_URL=http://localhost:8005
CLOUDX_COMPUTE_URL=http://localhost:8003
CLOUDX_NETWORK_URL=http://localhost:8001
CLOUDX_IMAGE_URL=http://localhost:8002
CLOUDX_VOLUME_URL=http://localhost:8004
CLOUDX_PLACEMENT_URL=http://localhost:8006

# ── Metadata API ─────────────────────────────────────────────────────────────
# Set METADATA_HMAC_KEY to enable HMAC-signed instance identity documents.
# Leave empty to disable signing (identity document still available unsigned).
METADATA_HMAC_KEY=
METADATA_BASE_URL=http://169.254.169.254

# ── Backups (Fase 5) ──────────────────────────────────────────────────────────
# Automated PostgreSQL + volume backups to MinIO/S3.
# Schedule is a standard cron expression evaluated in $TIMEZONE.
# Default: 23:00 (11 PM) every day, Asia/Jakarta.
BACKUP_ENABLED=true
BACKUP_CRON="0 23 * * *"
BACKUP_BUCKET=cloudx-backups
# Retention (number of snapshots to keep per tier).
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# ── Monitoring (Fase 5) ───────────────────────────────────────────────────────
# Prometheus scrapes API /metrics + exporters. Grafana visualizes.
PROMETHEUS_RETENTION=15d
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Internal TLS (Fase 5) ─────────────────────────────────────────────────────
# When enabled, service-to-service traffic uses the internal CA certs generated
# by services/certs/generate-certs.sh.
TLS_ENABLED=false
TLS_CERT_DIR=/etc/cloudx/certs
